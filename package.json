{
  "name": "softtech-core",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable foundation for Softtech projects",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "check:environment": "node --version && pnpm --version",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm --recursive --if-present run lint",
    "type-check": "pnpm --recursive --if-present run type-check",
    "build": "pnpm --recursive --if-present run build"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
